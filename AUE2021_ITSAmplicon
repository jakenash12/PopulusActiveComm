silva_fungi_filtered='silva_fungi_only_filtered.txt'
ITS_seqs='vsearch_dada2_premerged_repseqs.filtered.fasta'
ITS_otu_map_80='ITS_otu_map_80.txt'
ITS_tax='taxonomy_ghosttree.no_tax_removed.txt'

#Removes all non-fungal samples from Silva alignment
sbatch --wrap="ghost-tree silva extract-fungi $silva_aligned $silva_accession $silva_taxonomy $silva_fungi_only"

#Filter entropy and gap positions from Silva fungal only alignment
sbatch -o slurm-%j-silva_filter_entropy_gap.out --wrap="ghost-tree filter-alignment-positions $silva_fungi_only 0.9 0.8 $silva_fungi_filtered"

#group extensions sequences (i.e. OTU representative sequences) at 80% identity
sbatch -o slurm-%j-cluster_otus_80.out --wrap="ghost-tree extensions group-extensions $ITS_seqs 0.8 $ITS_otu_map_80"

#builds the ghost-tree
sbatch -o slurm-%j-build_ghosttree.out --wrap="ghost-tree scaffold hybrid-tree-foundation-alignment $ITS_otu_map_80 $ITS_tax $ITS_seqs $silva_fungi_filtered /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost_tree_output"

sbatch -o slurm-%j-build_ghosttree.out --wrap="ghost-tree scaffold hybrid-tree-foundation-tree $ITS_otu_map_80 $ITS_tax $ITS_seqs /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost_tree_output/nr_foundation_tree_gt.nwk $silva_taxonomy /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost_tree_output2"


##################
#an older version of QIIME is used for compatibility with ghost tree
conda activate qiime2-2019.7

#imports extension sequences
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.fasta \
--type FeatureData[Sequence] \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.qza"

#imports extension taxonomy
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/taxonomy_ghosttree.no_tax_removed.txt \
--type FeatureData[Taxonomy] \
--input-format HeaderlessTSVTaxonomyFormat \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/taxonomy_ghosttree.no_tax_removed.qza"

#imports silva fasta file and converts from RNA to DNA format
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/SILVA_119_SSURef_Nr99_tax_silva_full_align_trunc.fasta \
--type FeatureData[AlignedSequence] \
--input-format AlignedRNAFASTAFormat \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/SILVA_119_SSURef_Nr99_tax_silva_full_align_trunc.qza"

#imports silva taxonomy
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.txt \
--type SilvaTaxonomy \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.qza \
--input-format SilvaTaxonomyFormat"

#imports silva accession file
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.acc_taxid \
--type SilvaAccession \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.acc_taxid.qza \
--input-format SilvaAccessionFormat"

#Extract fungi only from Silva
sbatch --wrap="qiime ghost-tree extract-fungi \
--i-aligned-silva-file /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/SILVA_119_SSURef_Nr99_tax_silva_full_align_trunc.qza \
--i-accession-file /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.acc_taxid.qza \
--i-taxonomy-file /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/tax_slv_ssu_nr_119.qza \
--o-aligned-seqs /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/silva_fungi_only_full_aligned_119.qza"

#filter alignment positions
sbatch -o slurm-%j-filter_alignment.out --wrap="qiime ghost-tree filter-alignment-positions \
--i-aligned-sequences-file /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/silva_fungi_only_full_aligned_119.qza \
--p-maximum-gap-frequency 0.9 \
--p-maximum-position-entropy 0.8 \
--o-aligned-seqs /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/silva_fungi_only_full_aligned_119_FILTERED.qza"

#imports extension OTU map
sbatch --wrap="qiime tools import \
--input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ITS_otu_map_80.txt \
--type OtuMap \
--output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ITS_otu_map_80.qza"

#clusters rep seqs at 90%
sbatch --wrap="qiime ghost-tree extensions-cluster \
--i-extension-sequences /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.qza \
--p-similarity-threshold 0.90 \
--o-otu-map /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.otu_map.qza"

sbatch -o slurm-%j-ghosttree_from_alignment.out --wrap="qiime ghost-tree scaffold-hybrid-tree-foundation-alignment \
--i-otu-map /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.otu_map.qza \
--i-extension-taxonomy /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/taxonomy_ghosttree.no_tax_removed.qza \
--i-extension-sequences /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/vsearch_dada2_premerged_repseqs.filtered.qza \
--i-foundation-alignment /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/silva_fungi_only_full_aligned_119_FILTERED.qza \
--o-ghost-tree /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost-tree-foundation-tree-90-otus.qza"


sbatch --wrap="qiime tools export \
  --input-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost-tree-foundation-tree-90-otus.qza \
  --output-path /work/jan58/AUE2021_ITS_Amplicon/ghost_tree/ghost-tree-foundation-tree-90-otus.exported"