####This pipeline contains all scripts to generate the ITS ASV table, representative sequences, and taxonomic assignments
#The scripts for all of these analyses were done on the Duke DCC cluster with QIIME2 v2022.2.

##############################PEAR and ITSxpress run outside of QIIME2##############################################
#creates file list to loop through and removes suffix
ls /work/jan58/AUE2021_ITS_Amplicon/Nash_7546_22021801 | grep "R1_001.fastq.gz" > /work/jan58/AUE2021_ITS_Amplicon/filelist
sed -i 's/_R1_001.fastq.gz//g' /work/jan58/AUE2021_ITS_Amplicon/filelist

#runs PEAR to join paired end reads
for i in $(cat /work/jan58/AUE2021_ITS_Amplicon/filelist)
do
sbatch --wrap="pear \
  -f /work/jan58/AUE2021_ITS_Amplicon/Nash_7546_22021801/${i}_R1_001.fastq.gz \
  -r /work/jan58/AUE2021_ITS_Amplicon/Nash_7546_22021801/${i}_R2_001.fastq.gz \
  -o /work/jan58/AUE2021_ITS_Amplicon/PEARReads/${i}_PEAR.fastq.gz"
done

#renames the joined read files
for i in $(cat /work/jan58/AUE2021_ITS_Amplicon/filelist)
do
mv /work/jan58/AUE2021_ITS_Amplicon/PEARReads/${i}_PEAR.fastq.gz.assembled.fastq /work/jan58/AUE2021_ITS_Amplicon/PEARReads/${i}.assembled.fastq
done

#runs ITSxpress to extract the ITS2 region
for i in $(cat /work/jan58/AUE2021_ITS_Amplicon/filelist)
do
sbatch --wrap="itsxpress --fastq /work/jan58/AUE2021_ITS_Amplicon/PEARReads/${i}.assembled.fastq --single_end --region ITS2 --taxa Fungi \
--log /work/jan58/AUE2021_ITS_Amplicon/ITSxpressReads/${i}.logfile.txt --outfile /work/jan58/AUE2021_ITS_Amplicon/ITSxpressReads/${i}.ITS.fastq --threads 2"
done

##########################################################################################################################
#############################Extracted ITS2 sequences imported into QIIME2 for further analysis###########################

#activates the conda environment
conda activate qiime2-2022.2

#ITS2 sequences are imported into QIIME2
sbatch --wrap="qiime tools import \
  --type 'SampleData[SequencesWithQuality]' \
  --input-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/QIIME_manifest_premerged.txt \
  --output-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/premerged_demux.qza \
  --input-format SingleEndFastqManifestPhred33V2"

#creates summary of imported sequences
sbatch --partition=scavenger --wrap="qiime demux summarize \
  --i-data /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/premerged_demux.qza \
  --o-visualization /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/premerged_demux.qzv"

#uses DADA2 to denoise sequences and generate ASVs
sbatch --partition=scavenger --mem=100G --wrap="qiime dada2 denoise-single \
  --i-demultiplexed-seqs /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/premerged_demux.qza \
  --p-trunc-len 0 \
  --output-dir /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/dada2out_premerged \
  --p-n-threads 0"

#clusters ASVs into 97% similarity OTUs using VSEARCH
sbatch --mem=50G --partition=scavenger --wrap="qiime vsearch cluster-features-de-novo \
	--i-sequences /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/dada2out_premerged/representative_sequences.qza \
	--i-table /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/dada2out_premerged/table.qza \
	--p-perc-identity 0.97 \
	--p-threads 8 \
	--o-clustered-table /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_otu_table.qza \
	--o-clustered-sequences /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_repseqs.qza"

#uses a pretrained UNITE classifier to assign taxonomy to ITS sequences
sbatch -c 8 --mem=200G --wrap="qiime feature-classifier classify-sklearn \
	--i-reads /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_repseqs.qza \
	--i-classifier /work/jan58/Bio557_Truffle/ITS_dada2/unite_ver8_99_s_all_10.05.2021-Q2-2022.2.qza \
	--o-classification /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_taxonomy.qza \
	--p-n-jobs 8"

#extracts taxonomy table
sbatch --partition=scavenger --wrap="qiime tools extract \
  --input-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_taxonomy.qza \
  --output-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_taxonomy"

#creates visualization of denoising stats
qiime metadata tabulate \
--m-input-file denoising_stats.qza \
--o-visualization denoising_stats_premerged.qzv

#creates visualization of VSEARCH OTU table
sbatch --mem=50G --partition=scavenger --wrap="qiime metadata tabulate \
--m-input-file /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_otu_table_premerged.qza \
--o-visualization /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_otu_table_premerged.qzv"

#exports VSEARCH representative sequences as fasta
sbatch --wrap="qiime tools export \
  --input-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_repseqs.qza \
  --output-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_repseqs.fasta"

#exports VSEARCH OTU table as biom format
sbatch --wrap="qiime tools export \
  --input-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_otu_table.qza \
  --output-path /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_dada2_premerged_otu_table.biom"

#converts biom format OTU table into tsv
sbatch --partition=scavenger --mem=50G --wrap="biom convert -i /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_otu_table_premerged.biom/feature-table.biom -o /work/jan58/AUE2021_ITS_Amplicon/Qiime2_workingdirectory/vsearch_otu_table_premerged.tsv --to-tsv"